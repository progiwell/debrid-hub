# ==============================================================================
# SECTION 1: REQUIRED HOST SETTINGS (Docker Infrastructure)
# ==============================================================================
# These settings tell Docker where to find your files and which host port to open.
# Docker Compose requires these at startup to build the container environment.

# Host port for the Web UI and API (Default: 38415)
# Zero-collision high port, avoiding common conflicts on 8080/8181/9000/5000
PORT=38415

# Host download destination (where completed files will be saved)
# TRaSH Guides standard: /data/downloads
NAS_DOWNLOAD_PATH=/data/downloads

# Server host persistent config directory (where settings.json and jobs.db will live)
# Example: ./config or /opt/debrid-hub/config
NAS_CONFIG_PATH=./config

# Optional Server API secret header (X-API-Key) to protect endpoints from unauthorized LAN clients
# Leave empty if you do not want to require authentication on your local network
API_AUTH_KEY=

# File permission mask for shared host storage (002 allows group write)
UMASK=002


# ==============================================================================
# SECTION 2: HEADLESS / AUTOMATED DEPLOYMENTS ONLY (Optional)
# ==============================================================================
# Normal users do NOT need to set these in .env!
#
# Normal Setup Workflow:
#   1. Start the container using the Section 1 settings above.
#   2. Open http://<server-ip>:38415/settings in your browser.
#   3. Enter your Real-Debrid API key and adjust preferences.
#
# Once saved in the Web UI, settings are saved permanently to /config/settings.json
# and will persist across all container updates and image recreations.
#
# ONLY uncomment and configure the variables below if you are doing a "headless"
# deployment (e.g. CI/CD test runners, automated Ansible scripts, Kubernetes)
# where no human will ever open the web browser.
#
# RD_API_KEY=your_real_debrid_api_key_here
# RD_BASE_URL=https://api.real-debrid.com/rest/1.0
# ARIA2C_MAX_CONNECTIONS=16
# ARIA2C_SPLIT=16
# MAX_CONCURRENT_DOWNLOADS=3
# AUTO_EXTRACT=true
# CLEANUP_AFTER_EXTRACT=true
